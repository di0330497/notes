 {
  "id": "sh081",
  "scene": "동아리",
  "title": "동아리 — 회비",
  "level": "N3",
  "register": "casual",
  "lines": [
   {
    "who": "jihu",
    "s": "部費の集金、今月はどうする？",
    "ko": "동아리 회비 걷기, 이번 달은 어떻게 할까?"
   },
   {
    "who": "hana",
    "s": "一人千円でいい{っけ}？",
    "ko": "1인당 천 엔이면 됐던가?"
   },
   {
    "who": "ken",
    "s": "先月から千五百円になったんだよ。",
    "ko": "지난달부터 천오백 엔이 됐어."
   },
   {
    "who": "hana",
    "s": "{そうなんですね}。知らなかった。",
    "ko": "그렇군요. 몰랐어요."
   },
   {
    "who": "jihu",
    "s": "部長が言ってたよ。来月から合宿費も別に集める{ということだ}。",
    "ko": "부장님이 말했어. 다음 달부터 합숙비도 따로 걷는다고 해."
   },
   {
    "who": "ken",
    "s": "ええ、聞いてない。",
    "ko": "어, 못 들었어."
   },
   {
    "who": "hana",
    "s": "集金は{後|あと}でいい？",
    "ko": "회비는 나중에 걷어도 돼?"
   },
   {
    "who": "jihu",
    "s": "うん、来週のミーティングでまとめて集めよう。",
    "ko": "응, 다음 주 미팅에서 한꺼번에 걷자."
   },
   {
    "who": "ken",
    "s": "じゃあ、僕は名前を書く紙を用意する。",
    "ko": "그럼 나는 이름 쓸 종이를 준비할게."
   },
   {
    "who": "hana",
    "s": "助かる。金額は変わるかもしれないから、多めに持ってきて。",
    "ko": "고마워. 금액이 바뀔지도 모르니까 넉넉히 가져와."
   },
   {
    "who": "jihu",
    "s": "わかった。じゃあ、また連絡するね。",
    "ko": "알았어. 그럼 다시 연락할게."
   }
  ],
