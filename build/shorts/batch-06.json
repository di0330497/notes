[
 {
  "id": "sh076",
  "scene": "도서관",
  "title": "도서관 — 책 찾기",
  "level": "N5",
  "register": "polite",
  "lines": [
   {
    "who": "sato",
    "s": "こんにちは。何かお探しですか。",
    "ko": "안녕하세요. 뭔가 찾으시는 게 있나요?"
   },
   {
    "who": "jihu",
    "s": "日本史の本を探しているんですが。",
    "ko": "일본사 책을 찾고 있는데요."
   },
   {
    "who": "sato",
    "s": "あちらの棚は人で{いっぱい}ですね。",
    "ko": "저쪽 책장은 사람으로 가득하네요."
   },
   {
    "who": "jihu",
    "s": "静かに読める席はありますか。",
    "ko": "조용히 읽을 수 있는 자리가 있나요?"
   },
   {
    "who": "sato",
    "s": "窓側なら空いていますよ。",
    "ko": "창가 쪽이라면 비어 있어요."
   },
   {
    "who": "jihu",
    "s": "この本は[勉|べん][強|きょう]に役立ちそうですね。",
    "ko": "이 책은 공부에 도움이 될 것 같네요."
   },
   {
    "who": "sato",
    "s": "ええ、試験の前はいつも人気です。",
    "ko": "네, 시험 전에는 늘 인기예요."
   },
   {
    "who": "jihu",
    "s": "この前、同じ本を借り{たことがあります}。",
    "ko": "지난번에 같은 책을 빌린 적이 있어요."
   },
   {
    "who": "sato",
    "s": "では、こちらのやさしい本がいいと思います。",
    "ko": "그럼 이 쉬운 책이 좋을 것 같아요."
   },
   {
    "who": "jihu",
    "s": "このカードで借りる{ことができます}か。",
    "ko": "이 카드로 빌릴 수 있나요?"
   },
   {
    "who": "sato",
    "s": "もちろんです。カウンターでお願いします。",
    "ko": "물론이죠. 카운터에서 해 주세요."
   },
   {
    "who": "jihu",
    "s": "ありがとうございます。助かりました。",
    "ko": "감사합니다. 큰 도움이 됐어요."
   }
  ],
  "targets": [
   {
    "kind": "한자",
    "key": "強",
    "line": 5
   },
   {
    "kind": "문형",
    "key": "～たことがあります",
    "line": 7
   },
   {
    "kind": "문형",
    "key": "～ことができます",
    "line": 9
   },
   {
    "kind": "품사",
    "key": "いっぱい",
    "line": 2
   }
  ]
 },
 {
  "id": "sh077",
  "scene": "도서관",
  "title": "도서관 — 대출",
  "level": "N4",
  "register": "polite",
  "lines": [
   {
    "who": "jihu",
    "s": "すみません、この本を借りたいんですが。",
    "ko": "저기, 이 책을 빌리고 싶은데요."
   },
   {
    "who": "sato",
    "s": "あ、ジフさん。{ご[無沙汰|ぶさた]しております}。",
    "ko": "아, 지후 씨. 오랜만입니다."
   },
   {
    "who": "jihu",
    "s": "お久しぶりです。ここで働いていたんですね。",
    "ko": "오랜만이에요. 여기서 일하고 계셨군요."
   },
   {
    "who": "sato",
    "s": "はい、去年からです。今日は何をお探しですか。",
    "ko": "네, 작년부터요. 오늘은 뭘 찾으세요?"
   },
   {
    "who": "jihu",
    "s": "この本です。ずっと探していました。",
    "ko": "이 책이요. 계속 찾고 있었어요."
   },
   {
    "who": "sato",
    "s": "この本は予約が多くて、すぐに借りられる{わけがない}と思っていました。",
    "ko": "이 책은 예약이 많아서 당장 빌릴 수 있을 리가 없다고 생각했어요."
   },
   {
    "who": "jihu",
    "s": "今日たまたま返ってきたみたいです。",
    "ko": "오늘 우연히 반납된 모양이에요."
   },
   {
    "who": "sato",
    "s": "それはよかった。では、カードをお願いします。",
    "ko": "잘됐네요. 그럼 카드를 부탁드려요."
   },
   {
    "who": "jihu",
    "s": "留学生{に対して}、貸出の説明はありますか。",
    "ko": "유학생을 대상으로 한 대출 설명이 있나요?"
   },
   {
    "who": "sato",
    "s": "はい、英語の案内もご用意しています。",
    "ko": "네, 영어 안내도 준비하고 있어요."
   },
   {
    "who": "jihu",
    "s": "助かります。では、お願いします。",
    "ko": "도움이 되네요. 그럼 부탁드립니다."
   },
   {
    "who": "sato",
    "s": "返却は二週間後までです。ゆっくり読んでください。",
    "ko": "반납은 2주 뒤까지예요. 천천히 읽으세요."
   }
  ],
  "targets": [
   {
    "kind": "표현",
    "key": "ご無沙汰しております",
    "line": 1
   },
   {
    "kind": "문법",
    "key": "～わけがない",
    "line": 5
   },
   {
    "kind": "문법",
    "key": "～に対して",
    "line": 8
   }
  ]
 },
 {
  "id": "sh078",
  "scene": "도서관",
  "title": "도서관 — 공부",
  "level": "N2",
  "register": "polite",
  "lines": [
   {
    "who": "jihu",
    "s": "あ、サトウさん。{お久しぶりです}。",
    "ko": "아, 사토 씨. 오랜만이에요."
   },
   {
    "who": "sato",
    "s": "ジフさん、本当に久しぶりですね。",
    "ko": "지후 씨, 정말 오랜만이네요."
   },
   {
    "who": "jihu",
    "s": "学生[時|じ][代|だい]は、よくここで勉強しました。",
    "ko": "학생 때는 여기서 자주 공부했어요."
   },
   {
    "who": "sato",
    "s": "そういえば、今日は試験の準備ですか。",
    "ko": "그러고 보니, 오늘은 시험 준비인가요?"
   },
   {
    "who": "jihu",
    "s": "はい。今は留学生{として}、日本史を勉強しています。",
    "ko": "네. 지금은 유학생으로서 일본사를 공부하고 있어요."
   },
   {
    "who": "sato",
    "s": "大変ですね。この棚は資料が多いですよ。",
    "ko": "힘드시겠네요. 이 책장은 자료가 많아요."
   },
   {
    "who": "jihu",
    "s": "{あんな}古い辞書も使えるんですか。",
    "ko": "저런 오래된 사전도 쓸 수 있나요?"
   },
   {
    "who": "sato",
    "s": "ええ、貸出はできませんが、館内で使えます。",
    "ko": "네, 대출은 안 되지만 관내에서 쓸 수 있어요."
   },
   {
    "who": "jihu",
    "s": "いいですね。静かな席はどこですか。",
    "ko": "좋네요. 조용한 자리는 어디예요?"
   },
   {
    "who": "sato",
    "s": "二階の奥が静かですよ。",
    "ko": "2층 안쪽이 조용해요."
   },
   {
    "who": "jihu",
    "s": "ありがとうございます。では、行ってきます。",
    "ko": "감사합니다. 그럼 다녀올게요."
   },
   {
    "who": "sato",
    "s": "頑張ってくださいね。",
    "ko": "힘내세요."
   }
  ],
  "targets": [
