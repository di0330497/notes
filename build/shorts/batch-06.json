 {
  "id": "sh080",
  "scene": "동아리",
  "title": "동아리 — 역할 분담",
  "level": "N4",
  "register": "casual",
  "lines": [
   {
    "who": "jihu",
    "s": "役割、どう分ける？",
    "ko": "역할, 어떻게 나눌까?"
   },
   {
    "who": "hana",
    "s": "[四|よ][人|にん]だから、二人ずつでいいんじゃない？",
    "ko": "네 명이니까 둘씩 나누면 되지 않을까?"
   },
   {
    "who": "ken",
    "s": "それなら、俺とジフで買い出し、ハナは受付でどう？",
    "ko": "그러면 나랑 지후가 장보기, 하나는 접수 담당 어때?"
   },
   {
    "who": "hana",
    "s": "いいよ。でも、重い荷物は{あとで}運ぶんでしょ？",
    "ko": "좋아. 근데 무거운 짐은 나중에 옮기는 거지?"
   },
   {
    "who": "ken",
    "s": "うん、車を出せるから大丈夫。",
    "ko": "응, 차를 낼 수 있으니까 괜찮아."
   },
   {
    "who": "jihu",
    "s": "え、ケン車持ってるの？{うそでしょ}。",
    "ko": "어, 켄 차 있어? 거짓말이지."
   },
   {
    "who": "ken",
    "s": "持って{へん}よ。父さんのを借りるだけ。",
    "ko": "안 가지고 있어. 아버지 차를 빌리는 것뿐이야."
   },
   {
    "who": "hana",
    "s": "びっくりした。免許はあるの？",
    "ko": "깜짝 놀랐어. 면허는 있어?"
   },
   {
    "who": "ken",
    "s": "あるある。去年取った。",
    "ko": "있어 있어. 작년에 땄어."
   },
   {
    "who": "jihu",
    "s": "じゃあ、買い出しは任せたよ。",
    "ko": "그럼 장보기는 맡길게."
   },
   {
    "who": "hana",
    "s": "私は飲み物と紙皿を担当するね。",
    "ko": "나는 음료랑 종이접시 맡을게."
   },
   {
    "who": "ken",
    "s": "よし、これで決まり。",
    "ko": "좋아, 이걸로 결정."
   }
  ],
