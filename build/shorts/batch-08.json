    "key": "もう",
    "line": 2
   },
   {
    "kind": "구어체",
    "key": "～ている → ～てる",
    "line": 9
   }
  ]
 },
 {
  "id": "sh113",
  "scene": "발음 연습",
  "title": "발음 연습 — 악센트",
  "level": "N4",
  "register": "casual",
  "lines": [
   {
    "who": "jihu",
    "s": "この前、友達の家に遊びに行ったんだ。",
    "ko": "저번에 친구 집에 놀러 갔어."
   },
   {
    "who": "hana",
    "s": "へえ、どうだった？",
    "ko": "오, 어땠어?"
   },
   {
    "who": "jihu",
    "s": "楽しかった。彼、[性格|せいかく]がすごくいいんだよ。",
    "ko": "재밌었어. 그 친구 성격이 정말 좋아."
   },
   {
    "who": "hana",
    "s": "いいね。何して遊んだの？",
    "ko": "좋네. 뭐 하고 놀았어?"
   },
   {
    "who": "jihu",
    "s": "猫と遊んでた。ずっと{ニャーニャー}鳴いてて。",
    "ko": "고양이랑 놀았어. 계속 야옹야옹 울어서."
   },
   {
    "who": "hana",
    "s": "かわいい。写真ある？",
    "ko": "귀엽다. 사진 있어?"
   },
   {
    "who": "jihu",
    "s": "あるよ。見る？",
    "ko": "있지. 볼래?"
   },
   {
    "who": "hana",
    "s": "見たい。",
    "ko": "보고 싶어."
   },
   {
    "who": "jihu",
    "s": "ほら。……で、帰るときに「{お邪魔しました}」って言ったら、笑われた。",
    "ko": "여기. ……그런데 나올 때 「실례했습니다」라고 했더니 웃더라."
   },
   {
    "who": "hana",
    "s": "え、どうして？",
    "ko": "어, 왜?"
   },
   {
    "who": "jihu",
    "s": "アクセントが変だったみたい。",
    "ko": "억센트가 이상했나 봐."
   },
   {
    "who": "hana",
    "s": "次は気をつければいいよ。",
    "ko": "다음엔 조심하면 되지."
   }
  ],
