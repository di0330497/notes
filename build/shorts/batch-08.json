 {
  "id": "sh107",
  "scene": "연애",
  "title": "연애 — 데이트",
  "level": "N4",
  "register": "casual",
  "lines": [
   {
    "who": "hana",
    "s": "{ただいま}。今日、ちょっと歩きすぎたね。",
    "ko": "다녀왔어. 오늘 좀 많이 걸었네."
   },
   {
    "who": "jihu",
    "s": "ほんと。足がもう限界。",
    "ko": "진짜. 다리 이제 한계야."
   },
   {
    "who": "hana",
    "s": "でも、楽しかったでしょ？",
    "ko": "그래도 재밌었지?"
   },
   {
    "who": "jihu",
    "s": "うん、すごく。あの店、また行きたい。",
    "ko": "응, 엄청. 그 가게 또 가고 싶어."
   },
   {
    "who": "hana",
    "s": "でしょ？　予約するのにいい[方法|ほうほう]があるんだ。",
    "ko": "그렇지? 예약하는 좋은 방법이 있어."
   },
   {
    "who": "jihu",
    "s": "へえ、{どうして}知ってるの？",
    "ko": "오, 어떻게 아는 거야?"
   },
   {
    "who": "hana",
    "s": "前にテレビでやってた。",
    "ko": "전에 TV에서 했어."
   },
   {
    "who": "jihu",
    "s": "なるほど。じゃあ、次は任せるね。",
    "ko": "그렇구나. 그럼 다음은 맡길게."
   },
   {
    "who": "hana",
    "s": "まかせて。来月も行こう。",
    "ko": "맡겨 둬. 다음 달에도 가자."
   },
   {
    "who": "jihu",
    "s": "いいね。次は昼からにしよう。",
    "ko": "좋네. 다음엔 낮부터 하자."
   }
  ],
  "targets": [
