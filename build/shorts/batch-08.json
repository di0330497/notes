 {
  "id": "sh110",
  "scene": "시험 공부",
  "title": "시험 공부 — 발음",
  "level": "N4",
  "register": "casual",
  "lines": [
   {
    "who": "ken",
    "s": "「[言語|げんご]」って、どう発音するの？",
    "ko": "「언어」는 어떻게 발음해?"
   },
   {
    "who": "jihu",
    "s": "「げんご」。最初の「げ」を高くする。",
    "ko": "「げんご」. 처음 「げ」를 높게."
   },
   {
    "who": "ken",
    "s": "「げんご」……合ってる？",
    "ko": "「げんご」…… 맞아?"
   },
   {
    "who": "jihu",
    "s": "うん、いい感じ。",
    "ko": "응, 좋은 느낌이야."
   },
   {
    "who": "ken",
    "s": "日本語って、同じ漢字でも読み方が多いよね。",
    "ko": "일본어는 같은 한자라도 읽는 법이 많네."
   },
   {
    "who": "jihu",
    "s": "そう。だから声に出したほうが覚えやすいよ。",
    "ko": "그래서 소리 내서 읽는 게 더 잘 외워져."
   },
   {
    "who": "ken",
    "s": "なるほど。……あ、外で犬が{ワンワン}鳴いてる。",
    "ko": "그렇구나. ……아, 밖에서 개가 멍멍 짖고 있어."
   },
   {
    "who": "jihu",
    "s": "ほんとだ。うるさいね。",
    "ko": "정말. 시끄럽네."
   },
   {
    "who": "ken",
    "s": "もう十一時なのに。",
    "ko": "벌써 열한 시인데."
   },
   {
    "who": "jihu",
    "s": "明日早いし、そろそろ寝よう。{おやすみなさい}。",
    "ko": "내일 일찍이니까 슬슬 자자. 잘 자."
   },
   {
    "who": "ken",
    "s": "おやすみ。また明日。",
    "ko": "잘 자. 내일 봐."
   }
  ],
  "targets": [
   {
