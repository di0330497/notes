 {
  "id": "sh108",
  "scene": "연애",
  "title": "연애 — 이별",
  "level": "N2",
  "register": "casual",
  "lines": [
   {
    "who": "jihu",
    "s": "{おかえりなさい}。遅かったね。",
    "ko": "어서 와. 늦었네."
   },
   {
    "who": "hana",
    "s": "ごめん。……ちょっと話したいことがあるの。",
    "ko": "미안. ……잠깐 할 얘기가 있어."
   },
   {
    "who": "jihu",
    "s": "うん。ちょうど俺も。",
    "ko": "응. 마침 나도."
   },
   {
    "who": "hana",
    "s": "私、来月から大阪に行くことになった。",
    "ko": "나, 다음 달부터 오사카에 가게 됐어."
   },
   {
    "who": "jihu",
    "s": "急だね。{どんな}仕事？",
    "ko": "갑작스럽네. 어떤 일?"
   },
   {
    "who": "hana",
    "s": "本社の企画の仕事。前から打診されてたんだ。",
    "ko": "본사 기획 일. 전부터 제안받고 있었어."
   },
   {
    "who": "jihu",
    "s": "そうか。……正直、[不安|ふあん]だな。",
    "ko": "그렇구나. ……솔직히 불안하네."
   },
   {
    "who": "hana",
    "s": "うん、私も。でも、決めたことだから。",
    "ko": "응, 나도. 그래도 정한 일이니까."
   },
   {
    "who": "jihu",
    "s": "遠距離、続けられると思う？",
    "ko": "장거리, 계속할 수 있을 것 같아?"
   },
   {
    "who": "hana",
    "s": "わからない。だから、ちゃんと話そうと思って。",
    "ko": "모르겠어. 그래서 제대로 얘기하려고."
   },
   {
    "who": "jihu",
    "s": "……そうだね。今日はゆっくり話そう。",
    "ko": "……그렇네. 오늘은 천천히 얘기하자."
   }
  ],
  "targets": [
