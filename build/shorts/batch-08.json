 },
 {
  "id": "sh111",
  "scene": "시험 공부",
  "title": "시험 공부 — 시험",
  "level": "N2",
  "register": "casual",
  "lines": [
   {
    "who": "ken",
    "s": "試験、どうだった？",
    "ko": "시험 어땠어?"
   },
   {
    "who": "jihu",
    "s": "聞かないでよ。",
    "ko": "묻지 마."
   },
   {
    "who": "ken",
    "s": "そんなにダメだった？",
    "ko": "그렇게 망쳤어?"
   },
   {
    "who": "jihu",
    "s": "最後の問題、全然わからなかった。",
    "ko": "마지막 문제, 전혀 몰랐어."
   },
   {
    "who": "ken",
    "s": "俺も。あの長い文章、読むだけで時間がなくなる。",
    "ko": "나도. 그 긴 문장, 읽는 것만으로 시간이 없어져."
   },
   {
    "who": "jihu",
    "s": "再来週は[体育|たいいく]の筆記もあるんだよね。",
    "ko": "재재주에 체육 필기 시험도 있잖아."
   },
   {
    "who": "ken",
    "s": "え、聞いてない。",
    "ko": "어, 못 들었어."
   },
   {
    "who": "jihu",
    "s": "{ああ}、もう帰りたい。",
    "ko": "아, 그냥 집에 가고 싶다."
   },
   {
    "who": "ken",
    "s": "とりあえず飯にしよう。腹減った。",
    "ko": "일단 밥 먹자. 배고파."
   },
   {
    "who": "jihu",
    "s": "そうだね。",
    "ko": "그래."
   },
   {
    "who": "ken",
    "s": "ほら、冷めないうちに。",
    "ko": "자, 식기 전에."
   },
   {
    "who": "jihu",
    "s": "{いただきます}。",
    "ko": "잘 먹겠습니다."
   }
  ],
