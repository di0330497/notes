 {
  "id": "sh109",
  "scene": "시험 공부",
  "title": "시험 공부 — 단어",
  "level": "N5",
  "register": "casual",
  "lines": [
   {
    "who": "ken",
    "s": "ねえ、この単語の読み方、わかる？",
    "ko": "이 단어 읽는 법, 알아?"
   },
   {
    "who": "jihu",
    "s": "どれ？",
    "ko": "어느 거?"
   },
   {
    "who": "ken",
    "s": "「[県|けん]」って書いてあるやつ。",
    "ko": "「県」라고 쓰여 있는 거."
   },
   {
    "who": "jihu",
    "s": "ああ、それは「けん」だよ。",
    "ko": "아, 그건 「けん」이야."
   },
   {
    "who": "ken",
    "s": "「[隣|となり]の県」って、よく聞くよね。",
    "ko": "「옆 현」이라고 자주 듣지."
   },
   {
    "who": "jihu",
    "s": "うん。{最近}はニュースでも多いよ。",
    "ko": "응. 요즘은 뉴스에서도 많이 봐."
   },
   {
    "who": "ken",
    "s": "そっか。じゃあ、あと十分だけ復習する。",
    "ko": "그렇구나. 그럼 십 분만 더 복습할게."
   },
   {
    "who": "jihu",
    "s": "もう遅い{から}、ほどほどにね。",
    "ko": "이미 늦었으니까 적당히 해."
   },
   {
    "who": "ken",
    "s": "わかってる。あと五分。",
    "ko": "알고 있어. 오 분만."
   },
   {
    "who": "jihu",
    "s": "終わったらコンビニ行こう。",
    "ko": "끝나면 편의점 가자."
   },
   {
    "who": "ken",
    "s": "賛成。甘いもの買いたい。",
    "ko": "찬성. 단 거 사고 싶어."
   }
  ],
  "targets": [
   {
