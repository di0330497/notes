[
 {
  "id": "sh106",
  "scene": "연애",
  "title": "연애 — 고백",
  "level": "N5",
  "register": "casual",
  "lines": [
   {
    "who": "hana",
    "s": "ねえ、ちょっと聞いてもいい？",
    "ko": "있어, 잠깐 물어봐도 돼?"
   },
   {
    "who": "jihu",
    "s": "うん、どうしたの？",
    "ko": "응, 왜?"
   },
   {
    "who": "hana",
    "s": "実はね、[多分|たぶん]もう気づいてると思うけど……",
    "ko": "사실은, 아마 이미 눈치챘을 것 같지만……"
   },
   {
    "who": "jihu",
    "s": "え、何？",
    "ko": "어, 뭐야?"
   },
   {
    "who": "hana",
    "s": "私、ずっと前から君のことが{好きです}。",
    "ko": "나, 계속 너를 좋아했어요."
   },
   {
    "who": "jihu",
    "s": "……え、ほんとに？",
    "ko": "……어, 정말?"
   },
   {
    "who": "hana",
    "s": "うん。冗談じゃないよ。",
    "ko": "응. 장난 아니야."
   },
   {
    "who": "jihu",
    "s": "ありがとう。実は俺も、君のことが{一番}気になってた。",
    "ko": "고마워. 사실 나도 네가 제일 신경 쓰였어."
   },
   {
    "who": "hana",
    "s": "じゃあ……付き合ってくれる？",
    "ko": "그럼…… 나랑 사귀어 줄래?"
   },
   {
    "who": "jihu",
    "s": "うん。よろしくね。",
    "ko": "응. 잘 부탁해."
   }
  ],
  "targets": [
