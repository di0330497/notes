 {
  "id": "sh112",
  "scene": "발음 연습",
  "title": "발음 연습 — 장음",
  "level": "N5",
  "register": "casual",
  "lines": [
   {
    "who": "hana",
    "s": "「おばさん」と「おばあさん」、聞き分けられる？",
    "ko": "「おばさん」과 「おばあさん」, 구분돼?"
   },
   {
    "who": "jihu",
    "s": "たぶん。でも、自分で言うのは自信ない。",
    "ko": "아마. 그래도 직접 말하는 건 자신 없어."
   },
   {
    "who": "hana",
    "s": "じゃあ、{もう}一回だけ言ってみて。",
    "ko": "그럼 한 번만 더 말해 봐."
   },
   {
    "who": "jihu",
    "s": "「おばあさん」……どう？",
    "ko": "「おばあさん」…… 어때?"
   },
   {
    "who": "hana",
    "s": "うん、今のは大丈夫。",
    "ko": "응, 방금 건 괜찮았어."
   },
   {
    "who": "jihu",
    "s": "よかった。長い音、苦手なんだ。",
    "ko": "다행이다. 긴 소리, 약해서."
   },
   {
    "who": "hana",
    "s": "妹も[進学|しんがく]の面接で、そこ直されたって。",
    "ko": "여동생도 진학 면접에서 거기 지적받았대."
   },
   {
    "who": "jihu",
    "s": "へえ、妹さん、もう受験なんだ。",
    "ko": "오, 여동생분 벌써 수험생이구나."
   },
   {
    "who": "hana",
    "s": "うん。毎晩、遅くまで大変だって。",
    "ko": "응. 매일 밤 늦게까지 힘들대."
   },
   {
    "who": "jihu",
    "s": "教科書には「練習している」って書いてあるけど、みんな{練習してる}って言うよね。",
    "ko": "교과서에는 「연습하고 있다」고 쓰여 있는데, 다들 「연습하고 있어」라고 하지."
   },
   {
    "who": "hana",
    "s": "そうそう。耳で覚えると、短くなるよね。",
    "ko": "맞아. 귀로 익히면 짧아지지."
   },
   {
    "who": "jihu",
    "s": "「おばあさん」。……今度はどう？",
    "ko": "「おばあさん」. …… 이번엔 어때?"
   }
  ],
  "targets": [
   {
    "kind": "한자",
    "key": "進",
    "line": 6
   },
   {
