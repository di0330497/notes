  "type": "NOT_IN_LINE",
  "kind": "활용표",
  "key": "조수사(助数詞) 읽기",
  "line": 5,
  "s": "じゃあ、卵を{三つ}と、玉ねぎを二つ使うね。"
 },
 {
  "id": "g109",
  "type": "NOT_IN_LINE",
  "kind": "활용표",
  "key": "날짜 · 시간 읽기의 예외",
  "line": 1,
