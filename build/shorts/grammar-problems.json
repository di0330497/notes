  "type": "NOT_IN_LINE",
  "kind": "활용표",
  "key": "시각·시간 완전표 — 1시~12시 & 1분~60분(ぷん/ふん 규칙)",
  "line": 5,
  "s": "そろそろ上がろう。{三時}を過ぎると潮が変わるって言うよ。"
 },
 {
  "id": "g139",
  "type": "NOT_IN_LINE",
  "kind": "활용표",
  "key": "상황별 실전 조수사 1~10 완전표 (식당·쇼핑·금액·생활)",
  "line": 0,
  "s": "この鯵、{二匹で三百円}？安いね。"
 },
 {
