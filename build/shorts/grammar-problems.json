  "type": "NOT_IN_LINE",
  "kind": "구어체",
  "key": "거친 문말 — ～かよ · ～じゃねーか · ～やがる",
  "line": 3,
  "s": "住民は「また値上げ{かよ}」と怒りをあらわにしていた。"
 },
 {
