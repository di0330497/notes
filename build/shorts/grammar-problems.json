  "type": "NOT_IN_LINE",
  "kind": "활용표",
  "key": "부사 호응(呼応の副詞)",
  "line": 5,
  "s": "承知しました。納期は{決して遅れません}ので、ご安心ください。"
 },
 {
  "id": "g122",
  "type": "NOT_IN_LINE",
  "kind": "문형",
  "key": "～ないわけにはいかない（심화）",
  "line": 2,
  "s": "そうですね。ただ、部長が同行すると聞いた以上、こちらも準備を{しないわけにはいきません}。"
 },
 {
  "id": "g122",
  "type": "NOT_IN_LINE",
  "kind": "문형",
  "key": "～ずにはいられない（심화）",
  "line": 3,
  "s": "分かっています。資料を見るたびに、{緊張せずにはいられません}。"
 },
 {
  "id": "g125",
  "type": "NOT_IN_LINE",
  "kind": "문형",
  "key": "お／ご～申し上げる・～いたしております 등",
  "line": 1,
  "s": "はい。調査の方法を簡単に{ご説明申し上げます}。"
 },
 {
  "id": "g127",
  "type": "NOT_IN_LINE",
  "kind": "활용표",
  "key": "달력 날짜 완전표 — 1일(ついたち)~31일 & 1월~12월",
  "line": 4,
  "s": "では、納品を来月{一日（ついたち）}にしていただけますか。"
 },
