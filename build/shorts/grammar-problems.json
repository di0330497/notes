  "type": "NOT_IN_LINE",
  "kind": "문법",
  "key": "～ものとする",
  "line": 0,
  "s": "当店では、傷んだ野菜は交換する{ものとしています}。"
 },
 {
  "id": "g145",
  "type": "NOT_IN_LINE",
  "kind": "문법",
  "key": "～こととする／～ものである",
  "line": 5,
  "s": "では、明日からもこちらで{買うこととします}。"
 },
