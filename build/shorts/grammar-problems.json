 },
 {
  "id": "g113",
  "type": "NOT_IN_LINE",
  "kind": "문법",
  "key": "～ではあるまいし",
  "line": 3,
  "s": "別に試験{じゃあるまいし}、そんなに気を張らなくても大丈夫だよ。"
 },
 {
