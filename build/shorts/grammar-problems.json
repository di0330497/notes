  "kind": "활용표",
  "key": "동사 3그룹 판별",
  "line": 5,
  "s": "そうですか。じゃあ、ランチ{にします}。"
 },
 {
  "id": "g002",
  "type": "NOT_IN_LINE",
  "kind": "문형",
  "key": "사전형＋ことができる",
  "line": 1,
  "s": "おかげさまで。やさしい本なら、辞書なしで{読むことができます}。"
 },
 {
  "id": "g007",
  "type": "NOT_IN_LINE",
  "kind": "활용표",
  "key": "1그룹(5단) 활용 총람",
  "line": 5,
  "s": "はい。お料理はすぐに{運びます}ので、少々お待ちください。"
 },
 {
  "id": "g008",
  "type": "NOT_IN_LINE",
  "kind": "문형",
  "key": "금지형（사전형＋な）",
  "line": 2,
  "s": "わかりました。でも「ソースを{こぼすな}」とも言われましたよね。"
 },
 {
  "id": "g013",
  "type": "NOT_IN_LINE",
  "kind": "활용표",
  "key": "2그룹(1단) 활용 총람",
  "line": 1,
  "s": "はい。チーズバーガーのセットを{食べます}。"
 },
 {
  "id": "g019",
  "type": "TARGET_MISSING",
  "kind": "활용표",
  "key": "3그룹 する·来る 활용 총람"
 },
 {
  "id": "g023",
  "type": "NOT_IN_LINE",
  "kind": "문형",
  "key": "～るところ",
  "line": 2,
  "s": "少々お待ちください。今、責任者を呼ぶ{ところ}です。"
 },
 {
  "id": "g023",
  "type": "NOT_IN_LINE",
  "kind": "문형",
  "key": "～ことにする",
  "line": 5,
  "s": "よかった。じゃあ、次からは必ず試着してから買う{ことにします}。"
 },
 {
  "id": "g025",
  "type": "NOT_IN_LINE",
  "kind": "활용표",
  "key": "て형 음편(音便) 규칙 — 1그룹 전용",
  "line": 5,
  "s": "分かりました。じゃあ、これを試着します。上着を脱い{で}から着てみます。"
 },
 {
  "id": "g026",
  "type": "NOT_IN_LINE",
  "kind": "문형",
  "key": "특별 겸양어（参る・申す・いただく・拝見する・伺う・おる 등）",
  "line": 4,
  "s": "いい心がけですね。お直しが必要でしたら、私が{いたします}。"
 },
 {
  "id": "g031",
  "type": "NOT_IN_LINE",
  "kind": "활용표",
  "key": "자동사 · 타동사 짝",
  "line": 5,
  "s": "はい、そうしてください。あっ、棚の本が{落ちて}いますよ。"
 },
 {
  "id": "g032",
  "type": "NOT_IN_LINE",
  "kind": "문형",
  "key": "～がする",
  "line": 3,
  "s": "かしこまりました。入荷したらすぐにご連絡します。あ、コーヒーのいい{匂いがします}ね。"
 },
 {
  "id": "g034",
  "type": "NOT_IN_LINE",
  "kind": "문형",
  "key": "～ことができます",
  "line": 5,
  "s": "それは助かります。予約なしでも{カットができます}か。"
 },
 {
  "id": "g037",
  "type": "NOT_IN_LINE",
  "kind": "문형",
  "key": "보통형（사전형・ない형・た형・なかった형）",
  "line": 1,
  "s": "朝から水を{飲む}とのどが痛いんです。"
 },
 {
  "id": "g037",
  "type": "NOT_IN_LINE",
  "kind": "활용표",
  "key": "て형 + 보조동사 정리",
  "line": 5,
  "s": "ありがとうございます。あ、こうやって口を開けて{みれば}いいですか。"
 },
 {
  "id": "g040",
  "type": "NOT_IN_LINE",
  "kind": "문형",
  "key": "조수사（～人・～つ・～枚・～本・～冊・～台・～匹・～回 등）",
  "line": 1,
  "s": "はい。この薬は{一日三回}、食後に飲んでください。"
 },
 {
  "id": "g043",
  "type": "NOT_IN_LINE",
  "kind": "활용표",
  "key": "い형용사 활용",
  "line": 4,
  "s": "東京から来ました。あ、この用紙、字が{小さい}ですね。"
 },
 {
  "id": "g049",
  "type": "NOT_IN_LINE",
  "kind": "활용표",
  "key": "な형용사 · 명사문 활용",
  "line": 1,
  "s": "この荷物を韓国に送りたいんですが、中身は本とお菓子{です}。"
 },
 {
  "id": "g053",
  "type": "NOT_IN_LINE",
  "kind": "문형",
  "key": "～てもらう",
  "line": 4,
  "s": "それはよかった。私は駅員さんに振替の切符を{もらいました}。"
 },
 {
  "id": "g054",
  "type": "NOT_IN_LINE",
  "kind": "문법",
  "key": "～得る（うる／える）",
  "line": 1,
  "s": "あの青い階段の先です。ただ、工事中ですので、遠回りになることも{あり得ます}。"
 },
 {
  "id": "g054",
  "type": "NOT_IN_LINE",
  "kind": "문법",
  "key": "～得ない（えない）",
  "line": 4,
  "s": "そうなんです。この時間に空いていることは{あり得ません}から、急いでください。"
 },
 {
  "id": "g059",
  "type": "NOT_IN_LINE",
  "kind": "문형",
  "key": "～てくる",
  "line": 3,
  "s": "ありがとうございます。朝が早くて、準備が足りないまま家を{出てきました}。"
 },
 {
  "id": "g061",
  "type": "NOT_IN_LINE",
  "kind": "활용표",
  "key": "접속 형태별 대표 표현",
  "line": 5,
  "s": "わかりました。では、荷物を{運びながら}、館内を案内してもらえますか。"
 },
 {
  "id": "g067",
  "type": "NOT_IN_LINE",
  "kind": "활용표",
  "key": "조건 4형 비교 — と · ば · たら · なら",
  "line": 1,
  "s": "この道をまっすぐ{行くと}、看板が見えますよ。"
 },
 {
